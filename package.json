{
  "name": "kamber-live",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "KAMBER Live: telemetría en tiempo real por Web Bluetooth para el dispositivo KAMBER",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host --mode https",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --mode https",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/three": "^0.186.0",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
